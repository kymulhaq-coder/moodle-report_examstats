{{!
    @template report_examstats/failurebreakdown

    Failure Breakdown Diagnostics table, shown only in combined
    (Theory + Skill) exam mode.

    Context variables required for this template:
    * strfailurebreakdown - string - section heading
    * strpointoffailure - string
    * strstudentcount - string
    * strfailedtheoryonly - string
    * strfailedskillonly - string
    * strfailedboth - string
    * strpassedskillbutmissedtheory - string
    * strpassedtheorybutmissedskill - string
    * strmissedbothcutoffs - string
    * failtheoryonly - int
    * failskillonly - int
    * failboth - int

    Example context (json):
    {
        "strfailurebreakdown": "Failure Breakdown Diagnostics",
        "strpointoffailure": "Point of Failure",
        "strstudentcount": "Student Count",
        "strfailedtheoryonly": "Failed Theory Only",
        "strfailedskillonly": "Failed Skill Only",
        "strfailedboth": "Failed Both",
        "strpassedskillbutmissedtheory": "Passed Skill but missed Theory cutoff",
        "strpassedtheorybutmissedskill": "Passed Theory but missed Skill cutoff",
        "strmissedbothcutoffs": "Missed cutoffs on both exams",
        "failtheoryonly": 3,
        "failskillonly": 2,
        "failboth": 5
    }
}}
<div class="mt-4">
  <h5 class="mb-3 font-weight-bold text-left re-section-heading">
    <i class="fa fa-stethoscope mr-2"></i>{{strfailurebreakdown}}
  </h5>
  <div class="table-responsive">
    <table class="table table-bordered table-striped m-0 text-left">
      <thead class="thead-dark">
        <tr>
          <th>{{strpointoffailure}}</th>
          <th class="text-center">{{strstudentcount}}</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <strong>{{strfailedtheoryonly}}</strong>
            <span class="text-muted small">({{strpassedskillbutmissedtheory}})</span>
          </td>
          <td class="text-center h5 text-danger font-weight-bold">{{failtheoryonly}}</td>
        </tr>
        <tr>
          <td>
            <strong>{{strfailedskillonly}}</strong>
            <span class="text-muted small">({{strpassedtheorybutmissedskill}})</span>
          </td>
          <td class="text-center h5 text-danger font-weight-bold">{{failskillonly}}</td>
        </tr>
        <tr>
          <td>
            <strong>{{strfailedboth}}</strong>
            <span class="text-muted small">({{strmissedbothcutoffs}})</span>
          </td>
          <td class="text-center h5 text-danger font-weight-bold">{{failboth}}</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
