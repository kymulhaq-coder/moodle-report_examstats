{{!
    @template report_examstats/reportheader

    Report title and Course / Exam Target / Basis summary lines.

    Context variables required for this template:
    * strpluginname - string
    * strcourse - string
    * coursefullname - string
    * strexamtarget - string
    * examtitles - string
    * strbasis - string
    * basistext - string

    Example context (json):
    {
        "strpluginname": "Exam Performance Report",
        "strcourse": "Course:",
        "coursefullname": "Pharmacology-I (NU-204)",
        "strexamtarget": "Exam Target:",
        "examtitles": "Exam-I (theory)",
        "strbasis": "Basis:",
        "basistext": "Total Cohort (KMU Rule)"
    }
}}
<div class="mb-4 text-left border-bottom pb-3">
  <h3 class="font-weight-bold text-dark mb-2">{{strpluginname}}</h3>
  <div class="font-weight-bold re-section-heading" style="font-size:1.05rem;line-height:1.6;">
    {{strcourse}} <span class="text-dark font-weight-normal">{{coursefullname}}</span>
  </div>
  <div class="font-weight-bold re-section-heading" style="font-size:1.05rem;line-height:1.6;">
    {{strexamtarget}} <span class="text-dark font-weight-normal">{{examtitles}}</span>
  </div>
  <div class="font-weight-bold re-section-heading" style="font-size:1.05rem;line-height:1.6;">
    {{strbasis}} <span class="text-dark font-weight-normal">{{basistext}}</span>
  </div>
</div>
