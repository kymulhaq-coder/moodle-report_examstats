{{!
    @template report_examstats/banddistribution

    Pass/Fail progress bars and the Performance Band Distribution table
    (bands A-D with descriptor, score range, student count, percentage).

    Context variables required for this template:
    * strpassed - string
    * strfailed - string
    * passedcount - int
    * failedcount - int
    * passpercent - number
    * failpercent - number

    * strband - string
    * strdescriptor - string
    * strscorerange - string
    * strstudents - string
    * strpctgraded - string
    * strperformancebanddistribution - string

    * bands - array of:
        * letter - string (A/B/C/D)
        * rowstyle - string (inline background colour for the row)
        * descriptor - string
        * scorerange - string
        * count - int
        * percent - number

    Example context (json):
    {
        "strpassed": "Passed",
        "strfailed": "Failed",
        "passedcount": 28,
        "failedcount": 12,
        "passpercent": 70,
        "failpercent": 30,
        "strband": "Band",
        "strdescriptor": "Descriptor",
        "strscorerange": "Score Range",
        "strstudents": "Students",
        "strpctgraded": "% of Graded",
        "strperformancebanddistribution": "Performance Band Distribution",
        "bands": [
            {"letter": "A", "rowstyle": "background:#d4edda;", "descriptor": "High Achiever", "scorerange": "\u2265 80%", "count": 10, "percent": 25}
        ]
    }
}}
{{! Section divider between the KPI cards above and this section }}
<hr class="my-4">

{{! Pass progress bar }}
<div class="mb-4">
  <div class="d-flex justify-content-between mb-1">
    <span><i class="fa fa-check-circle text-success mr-1"></i> <strong>{{strpassed}} ({{passedcount}} {{strstudents}})</strong></span>
    <span class="text-success font-weight-bold">{{passpercent}}%</span>
  </div>
  <div class="progress" style="height: 24px; border-radius: 4px;">
    <div class="progress-bar bg-success" style="width: {{passpercent}}%"></div>
  </div>
</div>

{{! Fail progress bar }}
<div class="mb-4">
  <div class="d-flex justify-content-between mb-1">
    <span><i class="fa fa-times-circle text-danger mr-1"></i> <strong>{{strfailed}} ({{failedcount}} {{strstudents}})</strong></span>
    <span class="text-danger font-weight-bold">{{failpercent}}%</span>
  </div>
  <div class="progress" style="height: 24px; border-radius: 4px;">
    <div class="progress-bar bg-danger" style="width: {{failpercent}}%"></div>
  </div>
</div>

{{! Grade Band Distribution table }}
<h5 class="mb-3 font-weight-bold text-left re-section-heading">
  <i class="fa fa-bar-chart mr-2"></i>{{strperformancebanddistribution}}
</h5>
<div class="table-responsive mb-2">
  <table class="table table-bordered m-0 text-center">
    <thead class="thead-dark">
      <tr>
        <th>{{strband}}</th>
        <th>{{strdescriptor}}</th>
        <th>{{strscorerange}}</th>
        <th>{{strstudents}}</th>
        <th>{{strpctgraded}}</th>
      </tr>
    </thead>
    <tbody>
      {{#bands}}
      <tr style="{{rowstyle}}">
        <td><strong>{{letter}}</strong></td>
        <td><strong>{{descriptor}}</strong></td>
        <td>{{{scorerange}}}</td>
        <td class="font-weight-bold">{{count}}</td>
        <td>{{percent}}%</td>
      </tr>
      {{/bands}}
    </tbody>
  </table>
</div>
