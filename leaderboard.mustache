{{!
    @template report_examstats/leaderboard

    Top 5 best performing students leaderboard.

    Context variables required for this template:
    * strtopfiveperformers - string - section heading
    * strscoresuffix - string - "Combined Total" or "Points" label shown under each score
    * performers - array of:
        * rank - int - 1-5
        * userpictureurl - string - rendered user picture HTML from $OUTPUT->user_picture(), including an alt attribute (already safe/escaped by core)
        * fullname - string - student's full name (already escaped)
        * score - number - achieved score

    Example context (json):
    {
        "strtopfiveperformers": "Top 5 Best Performing Students",
        "strscoresuffix": "Combined Total",
        "performers": [
            {
                "rank": 1,
                "userpictureurl": "<img src=\"...\" alt=\"Jane Doe\">",
                "fullname": "Jane Doe",
                "score": 87.5
            }
        ]
    }
}}
<div class="mt-5">
  <h5 class="mb-3 font-weight-bold text-dark text-left">
    <i class="fa fa-star text-warning mr-2"></i>{{strtopfiveperformers}}
  </h5>
  <div class="d-flex flex-wrap justify-content-center">
    {{#performers}}
    <div class="mb-3 px-2 text-center" style="flex: 1; min-width: 175px; max-width: 210px;">
      <div class="card border shadow-sm p-3 leaderboard-card">
        <div class="badge badge-warning text-dark font-weight-bold mb-2 position-absolute" style="top:10px; left:10px;">
          Rank #{{rank}}
        </div>
        <div class="mt-2">{{{userpictureurl}}}</div>
        <div class="font-weight-bold text-dark text-truncate mt-1">{{fullname}}</div>
        <div class="h5 font-weight-bold text-success mt-1 mb-0">{{score}}</div>
        <small class="text-muted">{{strscoresuffix}}</small>
      </div>
    </div>
    {{/performers}}
  </div>
</div>
